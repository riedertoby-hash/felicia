# Caddy: automatic HTTPS (Let's Encrypt) in front of Django.
{$DOMAIN} {
	encode zstd gzip

	handle_path /media/* {
		root * /srv/media
		file_server
		header Cache-Control "public, max-age=86400"
		header X-Content-Type-Options nosniff
	}

	handle {
		reverse_proxy web:8000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	request_body {
		max_size 10MB
	}

	log {
		output stdout
		format json
	}
}
