# Copy to .env and fill in. Never commit .env. scripts/server-setup.sh creates it automatically.
DOMAIN=shop.feldzutisch.ch
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=            # python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_ALLOWED_HOSTS=shop.feldzutisch.ch
DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.feldzutisch.ch
FIELD_ENCRYPTION_KEYS=        # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEFAULT_TENANT_SLUG=feldzutisch
POSTGRES_DB=felicia
POSTGRES_USER=felicia
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_SSLMODE=disable      # database runs in the private Docker network
# E-Mail via Infomaniak
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.infomaniak.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=noreply@feldzutisch.ch
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Feld zu Tisch <noreply@feldzutisch.ch>
MFA_TOTP_ISSUER=Feld zu Tisch
